/* ============================================================
   Design tokens — "Ledger" system
   A task board styled like a workshop ticket ledger: index-card
   task stubs, mono ticket IDs, a pine/ochre/brick status language.
   ============================================================ */
:root {
  --bg: #edf1ee;
  --surface: #ffffff;
  --surface-2: #f4f7f3;
  --ink: #16211b;
  --muted: #5b6b61;
  --muted-2: #8a988f;
  --border: #dbe3dc;
  --border-strong: #c3cfc6;

  --accent: #1e6e52;
  --accent-ink: #ffffff;
  --accent-soft: #e2efe8;

  --amber: #b8862f;
  --amber-soft: #f6ecd8;

  --brick: #b1452f;
  --brick-soft: #f7e4de;

  --slate: #74857c;
  --slate-soft: #e7ece8;

  --font-display: "Fraunces", Georgia, serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: "IBM Plex Mono", "SFMono-Regular", monospace;

  --radius: 10px;
  --radius-sm: 6px;
  --shadow-card:
    0 1px 2px rgba(22, 33, 27, 0.06), 0 1px 1px rgba(22, 33, 27, 0.04);
  --shadow-pop: 0 12px 32px rgba(22, 33, 27, 0.18);
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  font-weight: 600;
  margin: 0;
  letter-spacing: -0.01em;
}

p {
  margin: 0;
}

a {
  color: inherit;
}

button,
input,
textarea,
select {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

button {
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---------- Layout shell ---------- */

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 230px;
  flex-shrink: 0;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 20px 16px;
}

.sidebar-brand {
  display: flex;
  align-items: baseline;
  gap: 6px;
  padding: 0 4px 20px;
  margin-bottom: 16px;
  border-bottom: 1px dashed var(--border-strong);
}

.sidebar-brand .mark {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: var(--accent);
}

.sidebar-brand .sub {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted-2);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.sidebar-user {
  padding: 10px 4px 18px;
  margin-bottom: 8px;
}

.sidebar-user .name {
  font-weight: 600;
  font-size: 14px;
}

.sidebar-user .email {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--muted);
  word-break: break-all;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.sidebar-nav a,
.sidebar-link {
  display: block;
  padding: 9px 10px;
  border-radius: var(--radius-sm);
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  background: none;
  border: none;
  text-align: left;
  width: 100%;
}

.sidebar-nav a:hover,
.sidebar-link:hover {
  background: var(--surface-2);
  color: var(--ink);
}

.sidebar-nav a.active {
  background: var(--accent-soft);
  color: var(--accent);
}

.sidebar-footer {
  border-top: 1px dashed var(--border-strong);
  padding-top: 12px;
}

.btn-logout {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 13px;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  width: 100%;
  text-align: left;
}

.btn-logout:hover {
  background: var(--brick-soft);
  color: var(--brick);
}

.main {
  flex: 1;
  min-width: 0;
  padding: 32px 40px 60px;
}

.main-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}

.main-header h1 {
  font-size: 26px;
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted-2);
  margin-bottom: 4px;
  display: block;
}

.page-desc {
  color: var(--muted);
  font-size: 14px;
  margin-top: 6px;
  max-width: 60ch;
}

/* ---------- Buttons ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  padding: 9px 16px;
  font-weight: 600;
  font-size: 13.5px;
  transition:
    transform 0.05s ease,
    background 0.15s ease,
    border-color 0.15s ease;
}

.btn:active {
  transform: translateY(1px);
}

.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
}
.btn-primary:hover {
  background: #185c44;
}
.btn-primary:disabled {
  background: var(--slate);
  cursor: not-allowed;
}

.btn-secondary {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--border-strong);
}
.btn-secondary:hover {
  background: var(--surface-2);
}

.btn-danger {
  background: var(--surface);
  color: var(--brick);
  border-color: var(--brick-soft);
}
.btn-danger:hover {
  background: var(--brick-soft);
}

.btn-ghost {
  background: none;
  color: var(--muted);
  border-color: transparent;
  padding: 6px 10px;
}
.btn-ghost:hover {
  background: var(--surface-2);
  color: var(--ink);
}

.btn-block {
  width: 100%;
  justify-content: center;
}
.btn-sm {
  padding: 6px 11px;
  font-size: 12.5px;
}

/* ---------- Forms ---------- */

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.field label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.field input,
.field textarea,
.field select {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  background: var(--surface);
  color: var(--ink);
  width: 100%;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--accent);
}

.field textarea {
  resize: vertical;
  min-height: 80px;
  font-family: inherit;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.field-error {
  font-size: 12px;
  color: var(--brick);
}

.field input.invalid,
.field textarea.invalid,
.field select.invalid {
  border-color: var(--brick);
}

.form-error-banner {
  background: var(--brick-soft);
  color: var(--brick);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  font-size: 13px;
  margin-bottom: 16px;
}

/* ---------- Auth screens ---------- */

.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  padding: 24px;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 28px 28px;
  background-position: -1px -1px;
}

.auth-card {
  width: 100%;
  max-width: 380px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px 28px 28px;
  box-shadow: var(--shadow-card);
}

.auth-brand {
  text-align: center;
  margin-bottom: 22px;
}

.auth-brand .mark {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 700;
  color: var(--accent);
}

.auth-brand .sub {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted-2);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
  margin-top: 2px;
}

.auth-switch {
  text-align: center;
  font-size: 13px;
  color: var(--muted);
  margin-top: 16px;
}

.auth-switch button {
  background: none;
  border: none;
  color: var(--accent);
  font-weight: 600;
  padding: 0;
}

/* ---------- Project list (ledger rows) ---------- */

.ledger {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  overflow: hidden;
}

.ledger-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  text-decoration: none;
  color: var(--ink);
  transition: background 0.12s ease;
}

.ledger-row:last-child {
  border-bottom: none;
}
.ledger-row:hover {
  background: var(--surface-2);
}

.ledger-index {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted-2);
  width: 40px;
  flex-shrink: 0;
}

.ledger-main {
  flex: 1;
  min-width: 0;
}

.ledger-main .title {
  font-weight: 600;
  font-size: 15px;
  margin-bottom: 3px;
}

.ledger-main .desc {
  font-size: 13px;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-meta {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-shrink: 0;
  font-size: 12.5px;
  color: var(--muted);
}

.avatar-stack {
  display: flex;
}

.avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  border: 2px solid var(--surface);
  font-size: 10.5px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8px;
  font-family: var(--font-mono);
}
.avatar-stack .avatar:first-child {
  margin-left: 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 600;
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.tag-admin {
  background: var(--accent-soft);
  color: var(--accent);
}
.tag-member {
  background: var(--slate-soft);
  color: var(--slate);
}

/* ---------- Empty / loading / error states ---------- */

.state-block {
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius);
  padding: 48px 24px;
  text-align: center;
  color: var(--muted);
}

.state-block h3 {
  font-size: 16px;
  color: var(--ink);
  margin-bottom: 6px;
}

.state-block p {
  font-size: 13.5px;
  max-width: 40ch;
  margin: 0 auto;
}

.state-block .btn {
  margin-top: 16px;
}

.spinner {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid var(--border-strong);
  border-top-color: var(--accent);
  animation: spin 0.7s linear infinite;
  display: inline-block;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.page-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 80px 0;
  color: var(--muted);
  font-size: 13.5px;
}

.toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: var(--ink);
  color: #fff;
  padding: 12px 18px;
  border-radius: var(--radius-sm);
  font-size: 13.5px;
  box-shadow: var(--shadow-pop);
  z-index: 200;
}
.toast.error {
  background: var(--brick);
}
.toast.success {
  background: var(--accent);
}

/* ---------- Kanban board ---------- */

.filter-bar {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.filter-bar select {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 7px 10px;
  background: var(--surface);
  font-size: 13px;
}

.filter-bar .clear-filters {
  font-size: 12.5px;
  color: var(--accent);
  background: none;
  border: none;
}

.board {
  display: grid;
  grid-template-columns: repeat(3, minmax(260px, 1fr));
  gap: 18px;
  align-items: start;
}

.board-col {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px;
  min-height: 200px;
}

.board-col.drag-over {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.board-col-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 6px 12px;
}

.board-col-head .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.dot-todo {
  background: var(--slate);
}
.dot-in_progress {
  background: var(--amber);
}
.dot-done {
  background: var(--accent);
}

.board-col-head .label {
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.board-col-head .count {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--muted-2);
  margin-left: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 1px 7px;
  border-radius: 999px;
}

/* Ticket-stub task card: perforated tear-edge on the left */
.ticket {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 10px;
  padding: 12px 12px 12px 16px;
  box-shadow: var(--shadow-card);
  cursor: grab;
  background-image: radial-gradient(
    circle at 0 0,
    transparent 5px,
    var(--surface) 5.5px
  );
}

.ticket::before {
  content: "";
  position: absolute;
  left: 8px;
  top: 4px;
  bottom: 4px;
  border-left: 1.5px dashed var(--border-strong);
}

.ticket:active {
  cursor: grabbing;
}
.ticket.dragging {
  opacity: 0.4;
}

.ticket-id {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--muted-2);
  letter-spacing: 0.03em;
}

.ticket-title {
  font-weight: 600;
  font-size: 14px;
  margin: 4px 0 6px;
  line-height: 1.35;
}

.ticket-desc {
  font-size: 12.5px;
  color: var(--muted);
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ticket-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.priority-chip {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 4px;
  letter-spacing: 0.03em;
}
.priority-low {
  background: var(--slate-soft);
  color: var(--slate);
}
.priority-medium {
  background: var(--amber-soft);
  color: var(--amber);
}
.priority-high {
  background: var(--brick-soft);
  color: var(--brick);
}

.ticket-due {
  font-size: 11px;
  color: var(--muted-2);
  font-family: var(--font-mono);
}
.ticket-due.overdue {
  color: var(--brick);
  font-weight: 600;
}

.ticket-avatar {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 9.5px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  flex-shrink: 0;
}

/* ---------- Modal ---------- */

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(22, 33, 27, 0.45);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 60px 20px;
  overflow-y: auto;
  z-index: 100;
}

.modal {
  background: var(--surface);
  border-radius: var(--radius);
  width: 100%;
  max-width: 460px;
  padding: 26px 26px 22px;
  box-shadow: var(--shadow-pop);
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.modal-head h2 {
  font-size: 19px;
}

.modal-close {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 20px;
  line-height: 1;
  padding: 2px 6px;
  border-radius: var(--radius-sm);
}
.modal-close:hover {
  background: var(--surface-2);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.modal-actions.split {
  justify-content: space-between;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 2px;
  border-bottom: 1px solid var(--border);
  font-size: 13.5px;
}
.member-row:last-child {
  border-bottom: none;
}

.help-text {
  font-size: 12px;
  color: var(--muted-2);
  margin-top: -8px;
  margin-bottom: 16px;
}

.hint-banner {
  background: var(--amber-soft);
  color: #7a5a1f;
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  font-size: 12.5px;
  margin-bottom: 16px;
}

@media (max-width: 900px) {
  .board {
    grid-template-columns: 1fr;
  }
  .main {
    padding: 24px 18px 48px;
  }
  .app-shell {
    flex-direction: column;
  }
  .sidebar {
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    overflow-x: auto;
    gap: 12px;
  }
  .sidebar-brand,
  .sidebar-user {
    display: none;
  }
  .sidebar-nav {
    flex-direction: row;
  }
  .sidebar-footer {
    border: none;
    padding: 0;
  }
  .ledger-row {
    flex-wrap: wrap;
  }
}
.filter-bar input[type="text"] {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 7px 10px;
  background: var(--surface);
  font-size: 13px;
  font-family: inherit;
  color: var(--ink);
  min-width: 180px;
}

.filter-bar input[type="text"]:focus {
  outline: none;
  border-color: var(--accent);
}

.pagination-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-top: 22px;
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--muted);
}

.pagination-bar .btn {
  padding: 6px 14px;
}

.pagination-bar .btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
