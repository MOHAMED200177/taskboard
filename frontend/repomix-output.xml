import { useState } from 'react';
import { initials } from '../utils';

export default function MemberModal({ project, onClose, onAdd, onRemove }) {
  const [userId, setUserId] = useState('');
  const [error, setError] = useState('');
  const [submitting, setSubmitting] = useState(false);

  const handleAdd = async (e) => {
    e.preventDefault();
    if (!userId.trim()) {
      setError('Enter a user ID.');
      return;
    }
    setSubmitting(true);
    setError('');
    try {
      await onAdd(userId.trim());
      setUserId('');
    } catch (err) {
      setError(err.message || 'Could not add that member.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="modal-backdrop" onMouseDown={onClose}>
      <div className="modal" onMouseDown={(e) => e.stopPropagation()}>
        <div className="modal-head">
          <h2>Members</h2>
          <button className="modal-close" onClick={onClose} aria-label="Close">
            ×
          </button>
        </div>

        <div style={{ marginBottom: 18 }}>
          {project.members.map((m) => (
            <div className="member-row" key={m.id}>
              <span style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span className="avatar" style={{ marginLeft: 0 }}>
                  {initials(m.name)}
                </span>
                {m.name}
                {m.id === project.createdBy.id && <span className="tag tag-admin">Admin</span>}
              </span>
              {m.id !== project.createdBy.id && (
                <button className="btn btn-ghost btn-sm" onClick={() => onRemove(m.id)}>
                  Remove
                </button>
              )}
            </div>
          ))}
        </div>

        <div className="hint-banner">
          Add a member by their user ID (UUID). Ask them to share it from their account, or find it in
          your database / seed data — the API doesn't expose a user search endpoint yet.
        </div>

        <form onSubmit={handleAdd} noValidate>
          <div className="field">
            <label htmlFor="member-id">User ID</label>
            <input
              id="member-id"
              className={error ? 'invalid' : ''}
              value={userId}
              onChange={(e) => setUserId(e.target.value)}
              placeholder="e.g. 3f1a9c2e-..."
            />
            {error && <span className="field-error">{error}</span>}
          </div>
          <div className="modal-actions">
            <button type="button" className="btn btn-secondary" onClick={onClose}>
              Close
            </button>
            <button type="submit" className="btn btn-primary" disabled={submitting}>
              {submitting ? 'Adding…' : 'Add member'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
